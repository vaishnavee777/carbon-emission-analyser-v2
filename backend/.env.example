DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/carbon_emissions
# Web Push keys: generate real ones with `python -m app.generate_vapid`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Grid carbon intensity used by CodeCarbon to measure model training (ISO 3166-1 alpha-3)
CODECARBON_COUNTRY=IND

# Set to 1 to log every SQL statement
SQL_ECHO=0

# Live grid carbon intensity (https://www.electricitymaps.com). Without a key the app uses the static factor.
ELECTRICITYMAPS_API_KEY=
# Indian zones: IN-NO (North), IN-SO (South), IN-WE (West), IN-EA (East), IN-NE (North-East)
GRID_ZONE=IN-SO

# Set to 1 when serving over HTTPS so the session cookie is only sent securely
COOKIE_SECURE=0
